rules_version = '2';

// Reglas de seguridad de Firestore de FoodDraft (proyectos `rueda-de-platos` y `rueda-de-platos-dev`).
//
// Son lo que de verdad protege los datos de salud de cada persona: la configuración web de Firebase
// (`apiKey` incluida) es pública por diseño y App Check solo frena el uso casual. Hasta noviembre de 2026
// vivían solo en la consola, sin historial ni pruebas (auditoría de noviembre, R1 y R2). Ahora esta es la
// única fuente: se publican con `firebase deploy --only firestore:rules` (primero en pruebas, después en
// producción) y se prueban con el emulador (`functions/pruebas-reglas/`). Nunca se editan a mano en la
// consola: un cambio ahí se pierde en el siguiente despliegue.
//
// Cómo guarda la app (`window.storage`, auth-bootstrap.jsx): un documento por clave en
// `users/{uid}/keys/{clave}` con un único campo, `value`, que es texto (JSON serializado, o el token de
// notificaciones en texto plano). Aparte, el buzón de avisos `users/{uid}/avisos/push` (R8, más abajo), con sus
// propios campos. El documento padre `users/{uid}` (premium y cuotas) solo lo escriben las Cloud Functions con
// el Admin SDK, que no pasa por estas reglas.
//
// Todo lo que no se permite aquí está denegado.

service cloud.firestore {
  match /databases/{database}/documents {

    // La sesión es de la dueña o el dueño de la cuenta, y su email está verificado. Sin sesión no se lee ni se
    // escribe nada. El email verificado es la verificación estricta (auditoría de noviembre, R15): la app ya
    // no deja pasar a una cuenta sin verificar (VerificarCorreoScreen, auth-bootstrap.jsx), y esto lo garantiza
    // también para quien hablara con Firestore sin la app. Las cuentas de Google llegan con
    // `email_verified: true`. El token se renueva al verificar; uno de antes dice `false` hasta que caduca
    // (como mucho, una hora) o se renueva. **Publicar estas reglas DESPUÉS de subir la app con la pantalla de
    // verificación**: al revés, una cuenta sin verificar vería un error de carga en vez de esa pantalla.
    function esSuCuenta(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    // Claves que la app guarda en la nube (`documentacion/datos.md`, «Claves en la nube»). Es una lista
    // cerrada y no un prefijo a propósito: así nadie puede llenar su cuenta de documentos inventados
    // (coste y datos basura, R2). Contrapartida: **una clave nueva en la app hay que añadirla aquí y
    // publicar las reglas ANTES de subir la app**, o su guardado fallará en todas las cuentas (igual que
    // una Cloud Function nueva). En el historial de git nunca hubo otras claves, así que la migración de
    // datos antiguos de `localStorage` (`migrateLocalDataIfNeeded`) no puede tropezar con esta lista.
    function esClaveConocida(clave) {
      return clave in [
        'rueda-de-platos:data-v1',
        'rueda-de-platos:menu-v1',
        'rueda-de-platos:history-v1',
        'rueda-de-platos:menu-simple-v1',
        'rueda-de-platos:history-simple-v1',
        'rueda-de-platos:despensa-v1',
        'rueda-de-platos:entreno-catalogo-v1',
        'rueda-de-platos:entreno-indice-v1',
        'rueda-de-platos:entreno-borrador-v1',
        'rueda-de-platos:cuerpo-diario-v1',
        'rueda-de-platos:informes-favoritos-v1',
        // Token de notificaciones de antes del buzón de avisos (R8), en retirada. Ya no lo lee ninguna función y
        // la app de ahora no lo escribe (solo lo borra, una vez por cuenta y aparato). Se queda un tiempo a
        // propósito: una copia vieja de la app lo escribe al activar los avisos y, sin la clave aquí, no podría
        // activarlos. Quitarlo es la fase 2 de la limpieza (documentacion/backend.md, «Paso del token de antes»).
        'rueda-de-platos:push-token-v1'
      ]
      // Un documento por mes de entreno (`entreno-AAAA-MM-v1`, logica/entreno-almacen.js), solo de 1970 a
      // 2099. Con cualquier año de cuatro cifras cabían 120 000 meses por cuenta, y la lista ya no ponía
      // techo a lo que se puede guardar (revisión de las reglas de noviembre de 2026); así quedan unos 1500.
      // El rango es el de `ANIO_MIN_ENTRENO` y `ANIO_MAX_ENTRENO` (logica/entreno-calculo.js): la app
      // descarta al importar, y no guarda al terminar, una fecha fuera de él. **Si cambia uno, cambia el
      // otro.** El techo de verdad para las funciones que leen todas las cuentas es no leerlas todas (R8).
      || clave.matches('rueda-de-platos:entreno-(19[7-9][0-9]|20[0-9][0-9])-(0[1-9]|1[0-2])-v1');
    }

    // Tamaño máximo de `value`, en caracteres. El token de notificaciones mide unos 160: con 4096 sobra.
    // El resto queda justo por debajo del tope de Firestore (1 MiB por documento, contando el nombre y el
    // campo): esta regla nunca es más estricta que Firestore con datos reales, que llevan tildes (2 bytes)
    // y llegan antes al tope de bytes. Un límite más bajo podría dejar sin guardar a una cuenta con muchos
    // datos (`data-v1` crece unos 150 KB al año, R3); su alarma de tamaño es otra tarea (R3-a).
    function tamanoMaximo(clave) {
      return clave == 'rueda-de-platos:push-token-v1' ? 4096 : 1048000;
    }

    // Exactamente un campo, `value`, de texto y dentro del tamaño. La forma interna del JSON no se puede
    // validar aquí: para las reglas es un texto opaco (R3).
    function esDocumentoValido(clave) {
      let datos = request.resource.data;
      return datos.keys().hasOnly(['value'])
        && datos.keys().hasAll(['value'])
        && datos.value is string
        && datos.value.size() <= tamanoMaximo(clave);
    }

    // Ficha de la cuenta: estado premium y contadores de cuota. Solo lectura para el cliente (la app la
    // escucha con onSnapshot para enterarse del pago); la escriben el webhook de Stripe y las funciones de
    // IA con el Admin SDK. Si el cliente pudiera escribirla, cualquiera se haría premium a mano.
    match /users/{userId} {
      allow get: if esSuCuenta(userId);
    }

    match /users/{userId}/keys/{clave} {
      // Leer un documento suelto, sí. Listar la colección, no: la app nunca lo hace (`storage.list()` está
      // prohibido porque descarga todos los datos de la cuenta, R11) y así queda garantizado.
      allow get: if esSuCuenta(userId);
      allow create, update: if esSuCuenta(userId)
        && esClaveConocida(clave)
        && esDocumentoValido(clave);
      // Borrar cualquier clave propia, también una desconocida: así se puede limpiar lo que hubiera quedado
      // de antes de existir la lista.
      allow delete: if esSuCuenta(userId);
    }

    // ---------- Buzón de avisos (auditoría de noviembre, R8 y R17) ----------
    // Lo que necesitan las funciones programadas de notificaciones (`sendWeighInReminders`,
    // `sendDefrostReminders`) para saber a quién avisar, separado del resto de datos de la cuenta. Antes lo
    // averiguaban leyendo **todos** los documentos de `keys` de **todas** las cuentas dos veces al día (coste que
    // crece con los datos de todo el mundo y lectura de datos de salud de quien ni siquiera tiene avisos, contra
    // la minimización del RGPD). Ahora consultan solo los documentos `avisos` (`collectionGroup("avisos")`).
    //
    // Un documento por cuenta y no uno por dispositivo, porque los interruptores de Ajustes son de la cuenta
    // (`perfil.notificacionesPush`, `perfil.avisoDescongelar`): quitarlos en el móvil los quita también en el
    // ordenador. Los dispositivos van en `tokens`, una lista, para que el móvil y el ordenador reciban los avisos
    // a la vez (R17: con un solo token, activarlos en un aparato los quitaba sin avisar del otro).
    //
    // Lo escribe la app (auth-bootstrap.jsx) al activar o quitar un aviso, al cambiar de idioma o el seguimiento de
    // peso y al abrirse; las funciones quitan con el Admin SDK los tokens que FCM da por caducados. **Estas reglas se publican ANTES de
    // subir la app que escribe el buzón**, o su escritura fallará en todas las cuentas.
    //
    // Forma: { idioma, pesaje, descongelar, tokens, actualizado } obligatorios, más tres opcionales del seguimiento
    // de peso (tanda B, M2), y nada más.
    // - `idioma`: uno de los cinco de la app (logica/i18n.js); con él se elige el texto del aviso.
    // - `pesaje`, `descongelar`: copia de los dos interruptores del perfil.
    // - `tokens`: hasta 10 dispositivos (un móvil, un ordenador, una tableta y los que se renueven entre
    //   medias sobran); cada uno, texto de 1 a 4096 caracteres (un token de FCM mide unos 160). Puede quedar
    //   vacía si se cierra la sesión en todos los aparatos.
    // - `actualizado`: la hora del servidor de cada escritura (`serverTimestamp()`), nunca una inventada por el
    //   cliente. Sirve para reconocer un buzón abandonado.
    // - Opcionales, para que el recordatorio de pesaje decida sin abrir `data-v1` (hasta 1 MiB con el perfil, el
    //   catálogo y el historial de peso) de cada cuenta cada mañana: `pesoVecesSemana` (2 o 3 pesadas a la semana, o
    //   `null` sin seguimiento), `pesoPausado` (sí/no) y `ultimaPesada` (`AAAA-MM-DD` de la última pesada del ciclo,
    //   o `null`). **Nunca el peso**: solo cuándo, no cuánto. Opcionales porque los buzones escritos por la app de
    //   antes no los tienen y tienen que seguir valiendo (con ellos, la función abre `data-v1` como antes); y porque
    //   una copia de la app sin actualizar reescribe el buzón sin ellos.
    function esIdiomaDeLaApp(valor) {
      return valor is string && valor in ['es', 'en', 'ca', 'gl', 'eu'];
    }

    // Las frecuencias de `PESO_FRECUENCIAS` (logica/peso.js), o `null`. Entero, no decimal: la app manda 2 o 3 y
    // la función compara con esos números. Una prueba de las reglas comprueba que acepta todas las de la app.
    function esFrecuenciaDePeso(valor) {
      return valor == null || (valor is int && valor in [2, 3]);
    }

    // Una fecha `AAAA-MM-DD` (fechaISO de logica/peso.js), o `null`. Solo la forma: la función solo la compara con
    // el día de hoy, así que una fecha imposible (mes 13) no cambia nada, y la app manda `null` en vez de una que
    // no tenga esta forma (si las reglas fueran más estrictas que la app, se rechazaría el buzón entero).
    function esFechaDePesada(valor) {
      return valor == null || (valor is string && valor.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    // Las reglas no tienen bucles: cada posición de la lista se comprueba por separado. Una posición que no
    // existe (lista más corta) vale.
    function esTokenValido(tokens, i) {
      return tokens.size() <= i
        || (tokens[i] is string && tokens[i].size() > 0 && tokens[i].size() <= 4096);
    }

    function esBuzonValido() {
      let datos = request.resource.data;
      let obligatorios = ['idioma', 'pesaje', 'descongelar', 'tokens', 'actualizado'];
      let todos = ['idioma', 'pesaje', 'descongelar', 'tokens', 'actualizado',
                   'pesoVecesSemana', 'pesoPausado', 'ultimaPesada'];
      return datos.keys().hasOnly(todos)
        && datos.keys().hasAll(obligatorios)
        && esIdiomaDeLaApp(datos.idioma)
        && datos.pesaje is bool
        && datos.descongelar is bool
        && datos.tokens is list
        && datos.tokens.size() <= 10
        && esTokenValido(datos.tokens, 0) && esTokenValido(datos.tokens, 1)
        && esTokenValido(datos.tokens, 2) && esTokenValido(datos.tokens, 3)
        && esTokenValido(datos.tokens, 4) && esTokenValido(datos.tokens, 5)
        && esTokenValido(datos.tokens, 6) && esTokenValido(datos.tokens, 7)
        && esTokenValido(datos.tokens, 8) && esTokenValido(datos.tokens, 9)
        && datos.actualizado == request.time
        // Los opcionales, solo si están (`get` con el valor por defecto que vale): un buzón sin ellos es válido.
        && esFrecuenciaDePeso(datos.get('pesoVecesSemana', null))
        && datos.get('pesoPausado', false) is bool
        && esFechaDePesada(datos.get('ultimaPesada', null));
    }

    match /users/{userId}/avisos/{aviso} {
      // Un único documento, `push`. Sin listar, como `keys`.
      allow get: if esSuCuenta(userId) && aviso == 'push';
      allow create, update: if esSuCuenta(userId) && aviso == 'push' && esBuzonValido();
      allow delete: if esSuCuenta(userId);
    }
  }
}
