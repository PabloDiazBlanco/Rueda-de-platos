{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-rueda-de-platos \"node --test pruebas-reglas/reglas.test.js\"",
    "test:avisos": "firebase emulators:exec --only firestore --project demo-rueda-de-platos \"node --test pruebas-funciones/avisos.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
